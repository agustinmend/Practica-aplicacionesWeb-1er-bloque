<div class="message">
    <div class="avatar">{{authorAvatar}}</div>
    <div class="message__body">
        <div class="message__meta">
        <strong class="message__author">{{authorName}}</strong>
        <span class="message__time">{{time}}</span>
        </div>
      <p class="message__text" contenteditable="true" data-message-id="{{id}}">{{text}}</p>
    </div>
</div>